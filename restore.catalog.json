   "id": "zinit",
   "group": "Shell & languages",
   "label": "zinit",
   "kind": "shell",
   "desc": "Zsh plugin manager (needed by .zshrc)",
   "cmd": "mkdir -p ~/.local/share/zinit && git clone https://github.com/zdharma-continuum/zinit.git ~/.local/share/zinit/zinit.git",
   "check": "test -d ~/.local/share/zinit/zinit.git",
   "requires": [],
   "interactive": false,
   "default": true
  },
  {
   "id": "node",
   "group": "Shell & languages",
   "label": "Node.js LTS (via nvm)",
   "kind": "shell",
   "desc": "Latest LTS Node through nvm",
   "cmd": "export NVM_DIR=\"$HOME/.nvm\"; mkdir -p \"$NVM_DIR\"; . \"$(brew --prefix nvm)/nvm.sh\" && nvm install --lts",
   "check": "ls ~/.nvm/versions/node 2>/dev/null | grep -q .",
   "requires": [
    "brew:nvm"
   ],
   "interactive": false,
   "default": true
  },
  {
