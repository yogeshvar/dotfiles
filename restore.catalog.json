   "check": "export NVM_DIR=\"$HOME/.nvm\"; . \"$(brew --prefix nvm)/nvm.sh\" >/dev/null 2>&1 && npm ls -g --depth=0 2>/dev/null | grep -q \"@anthropic-ai/claude-code@\"",
