   "group": "Shell & languages",
   "label": "Rust (rustup)",
   "kind": "shell",
   "desc": "Rust toolchain",
   "cmd": "curl https://sh.rustup.rs -sSf | sh -s -- -y",
   "check": "test -x ~/.cargo/bin/rustc",
   "requires": [],
   "interactive": false,
   "default": true
  },
