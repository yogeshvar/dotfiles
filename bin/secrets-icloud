#!/bin/bash
# secrets-icloud: encrypt your secrets into one file (default ~/Desktop), or restore them on a new Mac.
#
#   secrets-icloud backup            encrypt to ~/Desktop (or $SECRETS_DIR); asks for a passphrase
#   secrets-icloud restore [file]    decrypt the newest backup in that folder (or [file]) into $HOME
#   secrets-icloud list              show what is in the newest backup
#   secrets-icloud backup --dry-run  show what would be included
#
# The passphrase is typed by you at the prompt and never stored. Lose it and the
# archive cannot be opened. Edit ITEMS below to change what gets backed up.
set -euo pipefail

ICLOUD="${SECRETS_DIR:-$HOME/Desktop}"   # where backups are written/read; default Desktop, move it to iCloud yourself
ITEMS=(
  .ssh .aws .pgpass .zshrc.local .claude.json
  Work/Fun/buddio/.env
  Work/Fun/bubu-blog/.env
  Work/Fun/bubu-blog/.env.local
)
CIPHER=(-aes-256-cbc -pbkdf2 -iter 600000)

die() { echo "error: $*" >&2; exit 1; }
newest() { ls -t "$ICLOUD"/mac-secrets-*.tar.enc 2>/dev/null | head -1; }

cmd="${1:-}"; shift || true
case "$cmd" in
  backup)
    [ -d "$ICLOUD" ] || die "folder not found: $ICLOUD"
    cd "$HOME"
    present=()
    for f in "${ITEMS[@]}"; do [ -e "$f" ] && present+=("$f") || echo "skip (missing): $f"; done
    [ ${#present[@]} -gt 0 ] || die "nothing to back up"
    echo "Including:"; printf '  %s\n' "${present[@]}"
    [ "${1:-}" = "--dry-run" ] && exit 0
    out="$ICLOUD/mac-secrets-$(date +%Y%m%d-%H%M%S).tar.enc"
    tar --exclude=.ssh/agent --exclude=.ssh/known_hosts.old -cf - "${present[@]}" | openssl enc "${CIPHER[@]}" -salt -out "$out"
    echo "Saved: $out ($(du -h "$out" | cut -f1))"
    echo "Verifying: enter the passphrase again..."
    n=$(openssl enc -d "${CIPHER[@]}" -in "$out" | tar -tf - | wc -l)
    echo "OK: archive decrypts and holds $n entries."
    echo "Now move it to iCloud Drive yourself and confirm it synced before you reset."
    ;;
  restore)
    f="${1:-$(newest)}"; [ -n "$f" ] && [ -f "$f" ] || die "no mac-secrets-*.tar.enc in $ICLOUD (set SECRETS_DIR=/path or pass the file)"
    echo "Restoring from: $f"
    openssl enc -d "${CIPHER[@]}" -in "$f" | tar -xf - -C "$HOME"
    chmod 700 "$HOME/.ssh" 2>/dev/null || true
    chmod 600 "$HOME"/.ssh/id_* "$HOME/.pgpass" 2>/dev/null || true
    chmod 644 "$HOME"/.ssh/*.pub 2>/dev/null || true
    echo "Restored into $HOME. Next: ssh -T git@github.com && gh auth login"
    ;;
  list)
    f="${1:-$(newest)}"; [ -n "$f" ] && [ -f "$f" ] || die "no backup found"
    openssl enc -d "${CIPHER[@]}" -in "$f" | tar -tf -
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
