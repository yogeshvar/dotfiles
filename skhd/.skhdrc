#KeyClu[System]: Toggle sketchybar visibility
shift + lalt - space : sketchybar --bar hidden=toggle

#KeyClu[Layout]: Balance windows in space
alt - e : yabai -m space --balance
#KeyClu[Layout]: Switch to BSP (tiled) layout
alt - b : yabai -m space --layout bsp
#KeyClu[Layout]: Switch to float layout
alt - f : yabai -m space --layout float
#KeyClu[Layout]: Switch to stack layout
alt - s : yabai -m space --layout stack

#KeyClu[Window management]: Toggle float + center window
shift + alt - p : \
  if $(yabai -m query --windows --window | jq '."is-floating"'); then \
    yabai -m window --toggle topmost; \
    yabai -m window --toggle sticky; \
    yabai -m window --toggle float; \
  else \
    yabai -m window --toggle float; \
    yabai -m window --grid 6:6:4:0:2:2; \
    yabai -m window --toggle sticky; \
    yabai -m window --toggle topmost; \
  fi

#KeyClu[Window management]: Decrease window opacity
shift + lalt - 0 : yabai -m window --opacity $(yabai -m query --windows --window | jq '."opacity" - 0.25 | if . < 0.25 then 0.25 else . end')
#KeyClu[Window management]: Increase window opacity
shift + lalt - 9 : yabai -m window --opacity $(yabai -m query --windows --window | jq '."opacity" + 0.25 | if . > 1.0 then 1.0 else . end')

#KeyClu[Window management]: Resize window (grid preset 1)
shift + lalt - 1 : yabai -m window --grid 8:8:6:0:2:2
#KeyClu[Window management]: Resize window (grid preset 2)
shift + lalt - 2 : yabai -m window --grid 5:5:3:0:2:2

#KeyClu[mpv]: Toggle mpv float/minimize
shift + lalt - m : \
  minimized=$(yabai -m query --windows | jq '.[] | select(.app == "mpv") | ."is-minimized"' | head -1); \
  if [ "$minimized" = "true" ]; then \
    yabai -m window --deminimize $(yabai -m query --windows | jq '.[] | select(.app == "mpv" and ."is-minimized" == true) | .id' | head -1); \
    yabai -m window --focus $(yabai -m query --windows | jq '.[] | select(.app == "mpv") | .id' | head -1); \
    yabai -m window --toggle sticky; \
    yabai -m window --toggle topmost; \
  else \
    yabai -m window --minimize $(yabai -m query --windows | jq '.[] | select(.app == "mpv") | .id' | head -1); \
  fi

#KeyClu[Window management]: Focus window west
alt - h : yabai -m window --focus west
#KeyClu[Window management]: Focus window south
alt - j : yabai -m window --focus south
#KeyClu[Window management]: Focus window north
alt - k : yabai -m window --focus north
#KeyClu[Window management]: Focus window east
alt - l : yabai -m window --focus east

#KeyClu[Window management]: Swap window west
shift + alt - h : yabai -m window --swap west
#KeyClu[Window management]: Swap window south
shift + alt - j : yabai -m window --swap south
#KeyClu[Window management]: Swap window north
shift + alt - k : yabai -m window --swap north
#KeyClu[Window management]: Swap window east
shift + alt - l : yabai -m window --swap east

#KeyClu[Window management]: Resize window from left edge
ctrl + alt - h : yabai -m window --resize left:-40:0
#KeyClu[Window management]: Resize window from bottom edge
ctrl + alt - j : yabai -m window --resize bottom:0:40
#KeyClu[Window management]: Resize window from top edge
ctrl + alt - k : yabai -m window --resize top:0:-40
#KeyClu[Window management]: Resize window from right edge
ctrl + alt - l : yabai -m window --resize right:40:0

#KeyClu[Layout]: Rotate layout 90°
alt - r : yabai -m space --rotate 90
#KeyClu[Layout]: Mirror layout on x-axis
shift + alt - r : yabai -m space --mirror x-axis

# space N might not exist yet (yabai never auto-creates it), so
# ensure-space.sh creates however many are missing first, then focuses it.
#KeyClu[Space navigation]: Focus space 1 (creating it if needed)
alt - 1 : ~/.config/scripts/ensure-space.sh 1 --focus
#KeyClu[Space navigation]: Focus space 2 (creating it if needed)
alt - 2 : ~/.config/scripts/ensure-space.sh 2 --focus
#KeyClu[Space navigation]: Focus space 3 (creating it if needed)
alt - 3 : ~/.config/scripts/ensure-space.sh 3 --focus
#KeyClu[Space navigation]: Focus space 4 (creating it if needed)
alt - 4 : ~/.config/scripts/ensure-space.sh 4 --focus
#KeyClu[Space navigation]: Focus space 5 (creating it if needed)
alt - 5 : ~/.config/scripts/ensure-space.sh 5 --focus

# move the focused window to a space and follow it there. Create first
# (without switching focus away from the window we're about to move),
# THEN move the window, THEN follow — switching focus before moving would
# move whatever's focused on the new (likely empty) space instead.
#KeyClu[Space navigation]: Move window to space 1 and follow
ctrl + alt - 1 : ~/.config/scripts/ensure-space.sh 1; yabai -m window --space 1; yabai -m space --focus 1
#KeyClu[Space navigation]: Move window to space 2 and follow
ctrl + alt - 2 : ~/.config/scripts/ensure-space.sh 2; yabai -m window --space 2; yabai -m space --focus 2
#KeyClu[Space navigation]: Move window to space 3 and follow
ctrl + alt - 3 : ~/.config/scripts/ensure-space.sh 3; yabai -m window --space 3; yabai -m space --focus 3
#KeyClu[Space navigation]: Move window to space 4 and follow
ctrl + alt - 4 : ~/.config/scripts/ensure-space.sh 4; yabai -m window --space 4; yabai -m space --focus 4
#KeyClu[Space navigation]: Move window to space 5 and follow
ctrl + alt - 5 : ~/.config/scripts/ensure-space.sh 5; yabai -m window --space 5; yabai -m space --focus 5

#KeyClu[Space navigation]: Focus next space
alt - right : yabai -m space --focus next
#KeyClu[Space navigation]: Focus previous space
alt - left : yabai -m space --focus prev

#KeyClu[Window management]: Close window
shift + alt - q : yabai -m window --close
#KeyClu[Window management]: Toggle zoom fullscreen
shift + alt - space : yabai -m window --toggle zoom-fullscreen

# easy focus switching that doesn't require a window to be in a specific
# direction — just cycles through every window on the current space
#KeyClu[Window management]: Focus next window
alt - tab : yabai -m window --focus next || yabai -m window --focus first
#KeyClu[Window management]: Focus previous window
shift + alt - tab : yabai -m window --focus prev || yabai -m window --focus last

#KeyClu[System]: Launch kitty
alt - return : kitty

#KeyClu[Window management]: Toggle native fullscreen
shift + alt - f : yabai -m window --toggle native-fullscreen

#KeyClu[Layout]: Set BSP insertion point west
shift + ctrl + alt - h : yabai -m window --insert west
#KeyClu[Layout]: Set BSP insertion point south
shift + ctrl + alt - j : yabai -m window --insert south
#KeyClu[Layout]: Set BSP insertion point north
shift + ctrl + alt - k : yabai -m window --insert north
#KeyClu[Layout]: Set BSP insertion point east
shift + ctrl + alt - l : yabai -m window --insert east

# explicit space create/destroy (alt-1..5 already auto-creates as needed)
#KeyClu[Space navigation]: Create new space
ctrl + alt - c : yabai -m space --create
#KeyClu[Space navigation]: Destroy current space
ctrl + alt - d : yabai -m space --destroy

#KeyClu[System]: Restart yabai
shift + ctrl + alt - r : \
  /usr/bin/env osascript -e 'display notification "Restarting yabai" with title "yabai"'; \
  yabai --restart-service

# predefined workspaces: jump to a pinned space and launch the right
# app(s) for that activity, or just focus them if already running
#KeyClu[Workspaces]: Reading — Safari (space 1)
cmd + alt - r : ~/.config/scripts/workspace-reading.sh
#KeyClu[Workspaces]: Entertainment — Brave (space 2)
cmd + alt - e : ~/.config/scripts/workspace-entertainment.sh
#KeyClu[Workspaces]: YouTube — subscription feed picker in mpv (space 3)
cmd + alt - y : ~/.config/scripts/workspace-youtube.sh
#KeyClu[Workspaces]: Valorant — live Twitch channel picker in mpv (space 4)
cmd + alt - v : ~/.config/scripts/workspace-valorant.sh
#KeyClu[Workspaces]: Dev — tmux (session "dev") + Cursor (space 5)
cmd + alt - d : ~/.config/scripts/workspace-dev.sh
