shift + lalt - space : sketchybar --bar hidden=toggle

alt - e : yabai -m space --balance
alt - b : yabai -m space --layout bsp
alt - f : yabai -m space --layout float
alt - s : yabai -m space --layout stack

shift + alt - p : \
  if $(yabai -m query --windows --window | jq '."is-floating"'); then \
    yabai -m window --toggle topmost; \
    yabai -m window --toggle sticky; \
    yabai -m window --toggle float; \
  else \
    yabai -m window --toggle float; \
    yabai -m window --grid 6:6:4:0:2:2; \
    yabai -m window --toggle sticky; \
    yabai -m window --toggle topmost; \
  fi

shift + lalt - 0 : yabai -m window --opacity $(yabai -m query --windows --window | jq '."opacity" - 0.25 | if . < 0.25 then 0.25 else . end')
shift + lalt - 9 : yabai -m window --opacity $(yabai -m query --windows --window | jq '."opacity" + 0.25 | if . > 1.0 then 1.0 else . end')

shift + lalt - 1 : yabai -m window --grid 8:8:6:0:2:2
shift + lalt - 2 : yabai -m window --grid 5:5:3:0:2:2

shift + lalt - m : \
  minimized=$(yabai -m query --windows | jq '.[] | select(.app == "mpv") | ."is-minimized"' | head -1); \
  if [ "$minimized" = "true" ]; then \
    yabai -m window --deminimize $(yabai -m query --windows | jq '.[] | select(.app == "mpv" and ."is-minimized" == true) | .id' | head -1); \
    yabai -m window --focus $(yabai -m query --windows | jq '.[] | select(.app == "mpv") | .id' | head -1); \
    yabai -m window --toggle sticky; \
    yabai -m window --toggle topmost; \
  else \
    yabai -m window --minimize $(yabai -m query --windows | jq '.[] | select(.app == "mpv") | .id' | head -1); \
  fi

# --- window focus/swap navigation (previously missing) ---
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

# resize the focused window against its nearest edge
ctrl + alt - h : yabai -m window --resize left:-40:0
ctrl + alt - j : yabai -m window --resize bottom:0:40
ctrl + alt - k : yabai -m window --resize top:0:-40
ctrl + alt - l : yabai -m window --resize right:40:0

# rotate / mirror the current layout
alt - r : yabai -m space --rotate 90
shift + alt - r : yabai -m space --mirror x-axis

# --- space navigation (previously missing) ---
# space N might not exist yet (yabai never auto-creates it), so create
# however many are missing first, then focus it.
alt - 1 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 1 ] && for i in $(seq $((1-count))); do yabai -m space --create; done; yabai -m space --focus 1
alt - 2 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 2 ] && for i in $(seq $((2-count))); do yabai -m space --create; done; yabai -m space --focus 2
alt - 3 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 3 ] && for i in $(seq $((3-count))); do yabai -m space --create; done; yabai -m space --focus 3
alt - 4 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 4 ] && for i in $(seq $((4-count))); do yabai -m space --create; done; yabai -m space --focus 4
alt - 5 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 5 ] && for i in $(seq $((5-count))); do yabai -m space --create; done; yabai -m space --focus 5

# move the focused window to a space and follow it there (same
# auto-create-if-missing logic)
ctrl + alt - 1 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 1 ] && for i in $(seq $((1-count))); do yabai -m space --create; done; yabai -m window --space 1; yabai -m space --focus 1
ctrl + alt - 2 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 2 ] && for i in $(seq $((2-count))); do yabai -m space --create; done; yabai -m window --space 2; yabai -m space --focus 2
ctrl + alt - 3 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 3 ] && for i in $(seq $((3-count))); do yabai -m space --create; done; yabai -m window --space 3; yabai -m space --focus 3
ctrl + alt - 4 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 4 ] && for i in $(seq $((4-count))); do yabai -m space --create; done; yabai -m window --space 4; yabai -m space --focus 4
ctrl + alt - 5 : count=$(yabai -m query --spaces | jq 'length'); [ $count -lt 5 ] && for i in $(seq $((5-count))); do yabai -m space --create; done; yabai -m window --space 5; yabai -m space --focus 5

# cycle to next/previous space
alt - right : yabai -m space --focus next
alt - left : yabai -m space --focus prev

# close / fullscreen (native macOS-style feel)
shift + alt - q : yabai -m window --close
shift + alt - space : yabai -m window --toggle zoom-fullscreen

# --- easy focus switching (doesn't require a window to be in a specific
# direction — just cycles through every window on the current space) ---
alt - tab : yabai -m window --focus next || yabai -m window --focus first
shift + alt - tab : yabai -m window --focus prev || yabai -m window --focus last

# --- extras carried over from the old (simplebar-era) config ---
alt - return : kitty

shift + alt - f : yabai -m window --toggle native-fullscreen

# set bsp insertion point on the focused window
shift + ctrl + alt - h : yabai -m window --insert west
shift + ctrl + alt - j : yabai -m window --insert south
shift + ctrl + alt - k : yabai -m window --insert north
shift + ctrl + alt - l : yabai -m window --insert east

# explicit space create/destroy (alt-1..5 already auto-creates as needed)
ctrl + alt - c : yabai -m space --create
ctrl + alt - d : yabai -m space --destroy

shift + ctrl + alt - r : \
  /usr/bin/env osascript -e 'display notification "Restarting yabai" with title "yabai"'; \
  yabai --restart-service
