#!/usr/bin/env sh

#
# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# see this wiki page for information:
#  - https://github.com/asmvik/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
#

# global settings
yabai -m config \
  external_bar off:40:0 \
  menubar_opacity 1.0 \
  mouse_follows_focus off \
  focus_follows_mouse off \
  display_arrangement_order default \
  window_origin_display default \
  window_placement second_child \
  window_insertion_point focused \
  window_zoom_persist on \
  window_shadow on \
  skip_window_focus_animation off \
  window_animation_duration 0.0 \
  window_animation_easing ease_out_circ \
  window_opacity_duration 0.0 \
  active_window_opacity 1.0 \
  normal_window_opacity 0.90 \
  window_opacity off \
  insert_feedback_color 0xffd75f5f \
  split_ratio 0.50 \
  split_type auto \
  auto_balance off \
  top_padding 12 \
  bottom_padding 12 \
  left_padding 12 \
  right_padding 12 \
  window_gap 06 \
  layout bsp \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap

yabai -m config layout bsp

# ensure the first 5 spaces exist and carry their labels (idempotent —
# only creates what's missing, safe to run on every yabai restart)
existing_spaces=$(yabai -m query --spaces | jq 'length')
if [ "$existing_spaces" -lt 5 ]; then
  for _ in $(seq $((5 - existing_spaces))); do
    yabai -m space --create
  done
fi
yabai -m space 1 --label "一"
yabai -m space 2 --label "二"
yabai -m space 3 --label "三"
yabai -m space 4 --label "四"
yabai -m space 5 --label "五"

yabai -m rule --add app="^mpv$" opacity=0.8 manage=off
yabai -m rule --add app="Finder" manage=off sticky=off

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

echo "yabai configuration loaded.."
